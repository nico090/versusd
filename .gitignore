# ── Secrets (defense in depth; subproject .gitignores also cover these) ──
.env
*.env
!*.env.example
**/.env
.env.*
!.env.example
**/.env.*
!**/.env.example

# ── Claude Code local settings ──
.claude/settings.local.json

# ── Python ──
**/.venv/
**/.venv-test/
**/__pycache__/
*.pyc
*.db
*.sqlite
*.sqlite3
**/.pytest_cache/

# ── Unity (the Unity project also has its own .gitignore) ──
com.unity.multiplayer.samples.coop/[Ll]ibrary/
com.unity.multiplayer.samples.coop/[Tt]emp/
com.unity.multiplayer.samples.coop/[Oo]bj/
com.unity.multiplayer.samples.coop/[Bb]uilds/
com.unity.multiplayer.samples.coop/[Ll]ogs/
com.unity.multiplayer.samples.coop/.vs/

# ── OS / editor cruft ──
.DS_Store
Thumbs.db
desktop.ini
*.swp

# Unity build output
com.unity.multiplayer.samples.coop/WindowsBuilds/
com.unity.multiplayer.samples.coop/WindowsBuilds.zip
com.unity.multiplayer.samples.coop/AndroidBuild/
*.apk
*.aab
*.zip
com.unity.multiplayer.samples.coop/.utmp/

# Accidental dev/null (created by shell redirects on Windows)
/dev/
*.rar
